all:
  hosts:
    vps1:
      ansible_host: <ssh-hostname>
      ansible_user: <admin-username>
      ansible_ssh_private_key_file: ~/.ssh/<key-file>
      ansible_ssh_common_args: '-o ProxyCommand="cloudflared access ssh --hostname %h" -o IdentitiesOnly=yes'
      ansible_python_interpreter: /usr/bin/python3
      admin_user: <admin-username>
